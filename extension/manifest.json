{
  "manifest_version": 3,
  "name": "dm Downloads",
  "version": "0.1.0",
  "description": "Sends your browser downloads to dm, the download manager in the Omarchy bar. Anything dm can't fetch stays in the browser.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-1.js"
  },
  "action": {
    "default_title": "dm Downloads",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
