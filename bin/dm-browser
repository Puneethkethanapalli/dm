#!/usr/bin/env python3
"""Install or remove dm's browser integration for Chromium-family browsers.

  dm-browser install     register the native host, load the extension
  dm-browser uninstall   undo both
  dm-browser status      show what's installed where

For every browser whose profile folder exists, the native messaging host
manifest goes into <profile>/NativeMessagingHosts/. The extension is loaded
the way Omarchy loads its own: by adding its folder to the --load-extension
line of the browser's ~/.config/<browser>-flags.conf (only flags files that
already exist are touched). Browsers need a restart to pick it up.
"""

import json
import os
import shutil
import sys

sys.dont_write_bytecode = True

PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HOST_NAME = "io.github.puneethkethanapalli.dm"
EXTENSION_ID = "pmcgbhhhniblapdhpgcjchlgdbjimknf"
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")

# (name, command, profile folder under ~/.config, flags file under ~/.config)
BROWSERS = [
    ("Brave Origin", "brave-origin", "BraveSoftware/Brave-Origin", "brave-origin-flags.conf"),
    ("Brave", "brave", "BraveSoftware/Brave-Browser", "brave-flags.conf"),
    ("Brave Beta", "brave-beta", "BraveSoftware/Brave-Browser-Beta", "brave-beta-flags.conf"),
    ("Brave Nightly", "brave-nightly", "BraveSoftware/Brave-Browser-Nightly", "brave-nightly-flags.conf"),
    ("Chromium", "chromium", "chromium", "chromium-flags.conf"),
    ("Google Chrome", "google-chrome-stable", "google-chrome", "chrome-flags.conf"),
]

FLAG = "--load-extension="


def extension_dir():
    return os.path.join(PLUGIN_DIR, "extension")


def host_manifest():
    return {
        "name": HOST_NAME,
        "description": "dm download manager (Omarchy bar)",
        "path": os.path.join(PLUGIN_DIR, "bin", "dm-native-host"),
        "type": "stdio",
        "allowed_origins": ["chrome-extension://%s/" % EXTENSION_ID],
    }


def write_file(path, text):
    tmp = path + ".dm-tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def edit_flags(path, add):
    """Add or remove our folder on the flags file's --load-extension line."""
    with open(path) as f:
        lines = f.read().splitlines()
    ours = extension_dir()
    found = False
    out = []
    for line in lines:
        if line.strip().startswith(FLAG):
            found = True
            paths = [p for p in line.strip()[len(FLAG):].split(",") if p and p != ours]
            if add:
                paths.append(ours)
            if paths:
                out.append(FLAG + ",".join(paths))
            continue
        out.append(line)
    if add and not found:
        out.append(FLAG + ours)
    text = "\n".join(out) + "\n"
    with open(path) as f:
        if f.read() == text:
            return False
    backup = path + ".dm-backup"
    if add and not os.path.exists(backup):
        with open(path) as src, open(backup, "w") as dst:
            dst.write(src.read())
    write_file(path, text)
    return True


def install():
    os.chmod(host_manifest()["path"], 0o755)
    hosts, loaded, manual = [], [], []
    for name, command, profile, flags in BROWSERS:
        profile_dir = os.path.join(CONFIG, profile)
        if not os.path.isdir(profile_dir):
            continue
        host_dir = os.path.join(profile_dir, "NativeMessagingHosts")
        os.makedirs(host_dir, exist_ok=True)
        write_file(os.path.join(host_dir, HOST_NAME + ".json"), json.dumps(host_manifest(), indent=2) + "\n")
        hosts.append(name)
        flags_path = os.path.join(CONFIG, flags)
        if os.path.isfile(flags_path):
            edit_flags(flags_path, add=True)
            loaded.append(name)
        elif shutil.which(command):
            manual.append(name)
    if not hosts:
        print("No Chromium-family browser profile found; skipped the browser extension.")
        return
    print("Browser extension ready for: %s. Restart the browser to activate it." % ", ".join(loaded or hosts))
    if manual:
        print("To use it in %s too, open its extensions page, turn on developer mode and"
              " load the folder %s" % (" or ".join(manual), extension_dir()))


def uninstall():
    for name, command, profile, flags in BROWSERS:
        host = os.path.join(CONFIG, profile, "NativeMessagingHosts", HOST_NAME + ".json")
        if os.path.exists(host):
            os.unlink(host)
        flags_path = os.path.join(CONFIG, flags)
        if os.path.isfile(flags_path):
            edit_flags(flags_path, add=False)
    print("Browser extension removed. Restart the browser to unload it.")


def status():
    for name, command, profile, flags in BROWSERS:
        if not os.path.isdir(os.path.join(CONFIG, profile)) or not shutil.which(command):
            continue
        host = os.path.exists(os.path.join(CONFIG, profile, "NativeMessagingHosts", HOST_NAME + ".json"))
        flags_path = os.path.join(CONFIG, flags)
        loaded = os.path.isfile(flags_path) and extension_dir() in open(flags_path).read()
        print("%-14s connector %-3s  extension %s" % (name, "yes" if host else "no", "loaded" if loaded else "not loaded"))


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    {"install": install, "uninstall": uninstall, "status": status}.get(action, status)()
